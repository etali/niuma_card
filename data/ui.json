  "sfx": {
    "_note": "音效表。sounds=每个音效名对应的 wav（音效名只在这里和文件名之间对一次）。actions=**游戏动作 → 用哪个音效、多响、什么音高**：代码只写动作名（sfx.play(\"combo_complete\")），响度和音高一个字面量都不写在代码里。sound=sounds 里的键，db=音量（省略=0.0），pitch=音高倍率（省略=1.0，实际播放还会叠 ±4% 随机，见 Sfx.play）。同一个音效可以被好几个动作用不同响度引用（deny 的四档、buy 的三档就是这么来的），所以动作名比音效名多。加动作只改这里；动作名代码里认不出会 push_error 而不是静默沉默（见 Sfx.action）",
    "sounds": {
      "pickup": "res://assets/sfx/pickup.wav",
      "drop": "res://assets/sfx/drop.wav",
      "stack": "res://assets/sfx/stack.wav",
      "complete": "res://assets/sfx/complete.wav",
      "confirm": "res://assets/sfx/confirm.wav",
      "buy": "res://assets/sfx/buy.wav",
      "deny": "res://assets/sfx/deny.wav",
      "upgrade": "res://assets/sfx/upgrade.wav",
      "attack": "res://assets/sfx/attack.wav",
      "broken": "res://assets/sfx/broken.wav",
      "win": "res://assets/sfx/win.wav",
      "lose": "res://assets/sfx/lose.wav"
    },
    "actions": {
      "_note_actions": "产出没有自己的音效：produce_land 复用 drop，每张产出的牌落地各响一声（整组一声说不出产出了几张，见 main._fly_from 和 test_arrivals T11）。所以它的 sound/db 必须和 card_drop 一样",
      "card_pickup": {
        "sound": "pickup",
        "db": -8.0
      },
      "card_drop": {
        "sound": "drop",
        "db": -8.0
      },
      "produce_land": {
        "sound": "drop",
        "db": -8.0
      },
      "pile_toggle": {
        "sound": "stack",
        "db": -4.0
      },
      "combo_complete": {
        "sound": "complete",
        "db": -2.0
      },
      "confirm_turn": {
        "sound": "confirm",
        "db": -3.0
      },
      "foe_action_done": {
        "sound": "confirm",
        "db": -3.0,
        "notification": true
      },
      "buy": {
        "sound": "buy",
        "db": -4.0
      },
      "pay": {
        "sound": "buy",
        "db": -6.0
      },
      "pawn": {
        "sound": "buy",
        "db": -3.0,
        "pitch": 0.9
      },
      "deny": {
        "sound": "deny",
        "db": -4.0
      },
      "deny_quiet": {
        "sound": "deny",
        "db": -6.0
      },
      "upgrade": {
        "sound": "upgrade",
        "db": -2.0
      },
      "attack": {
        "sound": "attack",
        "db": -1.0
      },
      "attack_tear": {
        "sound": "attack",
        "db": -8.0,
        "pitch": 1.3
      },
      "combo_broken": {
        "sound": "broken",
        "db": -2.0
      },
      "win": {
        "sound": "win"
      },
      "lose": {
        "sound": "lose"
      }
    }
  }
