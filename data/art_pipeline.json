      "work": {
        "name": "工作",
        "action": "纸山向下压，底下的打工人顶住，纸页弹起再落回。"
      },
      "employee": {
        "name": "员工",
        "action": "困眼员工交替敲键盘，屏幕打出勾，得意一瞬又继续。"
      },
      "leader": {
        "name": "领导",
        "action": "翘腿领导抬手指点江山，头顶的大饼越画越大，随后收手得意。"
      },
      "grinder": {
        "name": "卷王",
        "action": "绑头带的卷王眼睛放光，两只手高速敲出火花，纸张在桌边震起。"
      },
      "involution": {
        "name": "内卷",
        "action": "打工人在巨型仓鼠轮里奋力跑，轮子飞转，领带被甩平。"
      },
      "overtime": {
        "name": "加班",
        "action": "月亮趴在闹钟上打盹，钟下员工边敲键盘边点头，突然惊醒。"
      },
      "coffee": {
        "name": "咖啡",
        "action": "咖啡杯小睡打鼾，热汽翻涌，杯子睁大眼睛精神抖擞。"
      },
      "transfer": {
        "name": "甩锅",
        "action": "打工人托住装满文件的黑锅，一推一接地把锅甩向旁边的手。"
      },
      "meeting": {
        "name": "开会",
        "action": "领导反复指向圆饼，桌边两个员工打盹点头，又被敲醒。"
      },
      "bonus": {
        "name": "奖金",
        "action": "钓竿吊着大金币，员工垫脚伸手，总是差那么一点。"
      },
      "slack": {
        "name": "摸鱼",
        "action": "员工躲在办公桌后钓鱼，鱼从巨型咖啡杯里探头，悄悄落回。"
      },
      "outsource": {
        "name": "外包",
        "action": "大机械手接过整摞文件，压缩打包，工人松一口气。"
      },
      "rework": {
        "name": "返工",
        "action": "大印章重重盖下叉号，纸页和小人被震起，印章抬起准备再来。"
      }
